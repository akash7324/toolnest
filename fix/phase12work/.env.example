MONGODB_URI=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future Razorpay integration (server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AdSense integration is intentionally disabled until the site is ready for review.
# Example: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_ENABLED=false

# Production deployment
# Set NEXT_PUBLIC_APP_URL to your final HTTPS domain, for example:
# NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
# Keep MONGODB_URI and AUTH_SECRET server-only.
